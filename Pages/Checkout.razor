
@page "/checkout"
@implements IDisposable

@using Fcg.Web.Services.Carrinho
@using Fcg.Web.Services.Checkout
@using Fcg.Web.DTOs.Checkout
@using Microsoft.AspNetCore.Components

@inject ICarrinhoService CarrinhoService
@inject ICheckoutService CheckoutService
@inject NavigationManager Navigation

<PageTitle>Checkout - FCG</PageTitle>

<div class="checkout-page">
    <div class="checkout-header">
        <span class="section-label">FCG STORE</span>
        <h1>Finalizar compra</h1>

        @if (_retornoRecebido)
        {
            <p>Acompanhe abaixo o processamento do seu pedido.</p>
        }
        else
        {
            <p>Revise seu pedido antes de confirmar a compra.</p>
        }
    </div>

    @if (_retornoRecebido)
    {
        <section class="purchase-result">
            <div class="purchase-result-icon">
                @if (_statusPedido == "Approved")
                {
                    <span>✓</span>
                }
                else if (_statusPedido == "Rejected")
                {
                    <span>✕</span>
                }
                else
                {
                    <span>…</span>
                }
            </div>

            <div class="purchase-result-content">
                <span class="section-label">
                    @(_statusPedido == "Approved"
                        ? "PAGAMENTO APROVADO"
                        : _statusPedido == "Rejected"
                            ? "PAGAMENTO RECUSADO"
                            : "PAGAMENTO EM PROCESSAMENTO")
                </span>

                <h2>
                    @(_statusPedido == "Approved"
                        ? "Compra confirmada!"
                        : _statusPedido == "Rejected"
                            ? "Pagamento não aprovado"
                            : "Aguardando confirmação")
                </h2>

                <p>@_mensagemResultado</p>

                @if (!string.IsNullOrWhiteSpace(_orderId))
                {
                    <p>Pedido: @_orderId</p>
                }

                @if (_consultandoPedido)
                {
                    <p>Consultando atualização do pedido...</p>
                }

                @if (!string.IsNullOrWhiteSpace(_erro))
                {
                    <div class="checkout-error">
                        <strong>Não foi possível consultar o pedido</strong>
                        <span>@_erro</span>
                    </div>
                }
            </div>
        </section>

        @if (_compras.Count > 0)
        {
            <section class="purchase-list">
                <div class="purchase-list-header">
                    <div>
                        <span class="section-label">PEDIDO</span>
                        <h2>Detalhes da compra</h2>
                    </div>

                    <span class="purchase-count">
                        @_compras.Count
                        @(_compras.Count == 1 ? "jogo" : "jogos")
                    </span>
                </div>

                @foreach (var compra in _compras)
                {
                    <article class="purchase-item">
                        <div class="purchase-item-main">
                            <div class="purchase-item-icon">
                                <span>🎮</span>
                            </div>

                            <div class="purchase-item-info">
                                <span class="checkout-item-genre">
                                    @ObterNomeGenero(compra.Genero)
                                </span>

                                <h3>@compra.Titulo</h3>
                                <p>Pedido: @compra.OrderId</p>
                            </div>
                        </div>

                        <div class="purchase-item-right">
                            <strong>@compra.Preco.ToString("C")</strong>

                            @if (compra.Status == "Approved")
                            {
                                <span class="purchase-status approved">
                                    ✓ Aprovado
                                </span>
                            }
                            else if (compra.Status == "Rejected")
                            {
                                <span class="purchase-status rejected">
                                    ✕ Recusado
                                </span>
                            }
                            else
                            {
                                <span class="purchase-status pending">
                                    Pendente
                                </span>
                            }
                        </div>
                    </article>
                }
            </section>
        }

        <div class="purchase-actions">
            <button type="button"
                    class="checkout-button"
                    @onclick="VoltarParaCatalogo">
                Continuar comprando
            </button>

            <button type="button"
                    class="continue-button"
                    @onclick="VoltarParaBiblioteca">
                Ir para minha biblioteca
            </button>
        </div>
    }
    else if (CarrinhoService.Quantidade == 0)
    {
        <section class="checkout-empty">
            <div class="checkout-empty-icon">🛒</div>
            <h2>Seu carrinho está vazio</h2>
            <p>Adicione pelo menos um jogo antes de continuar.</p>

            <button type="button"
                    class="primary-button"
                    @onclick="VoltarParaCatalogo">
                Explorar catálogo
            </button>
        </section>
    }
    else
    {
        <div class="checkout-content">
            <section class="checkout-items">
                <div class="checkout-section-header">
                    <div>
                        <span class="section-label">SEU PEDIDO</span>
                        <h2>Jogos selecionados</h2>
                    </div>

                    <span class="checkout-item-count">
                        @CarrinhoService.Quantidade
                        @(CarrinhoService.Quantidade == 1 ? "item" : "itens")
                    </span>
                </div>

                @foreach (var jogo in CarrinhoService.Itens)
                {
                    <article class="checkout-item">
                        <div class="checkout-item-icon">
                            <span>🎮</span>
                        </div>

                        <div class="checkout-item-info">
                            <span class="checkout-item-genre">
                                @ObterNomeGenero(jogo.Genero)
                            </span>

                            <h3>@jogo.Titulo</h3>
                            <p>@jogo.Descricao</p>
                        </div>

                        <strong>@jogo.Preco.ToString("C")</strong>
                    </article>
                }
            </section>

            <aside class="checkout-summary">
                <span class="section-label">CHECKOUT</span>
                <h2>Resumo do pedido</h2>

                <div class="summary-row">
                    <span>Quantidade</span>
                    <strong>@CarrinhoService.Quantidade</strong>
                </div>

                <div class="summary-row">
                    <span>Total</span>
                    <strong class="summary-total">
                        @CarrinhoService.Total.ToString("C")
                    </strong>
                </div>

                <div class="summary-divider"></div>

                @if (!string.IsNullOrWhiteSpace(_erro))
                {
                    <div class="checkout-error">
                        <strong>Não foi possível criar o pedido</strong>
                        <span>@_erro</span>
                    </div>
                }

                <button type="button"
                        class="checkout-button"
                        disabled="@_processando"
                        @onclick="ConfirmarCompra">
                    @if (_processando)
                    {
                        <span class="checkout-spinner"></span>
                        <span>Criando pedido...</span>
                    }
                    else
                    {
                        <span>Confirmar compra</span>
                    }
                </button>

                <button type="button"
                        class="continue-button"
                        disabled="@_processando"
                        @onclick="VoltarParaCarrinho">
                    Voltar ao carrinho
                </button>

                <small class="checkout-security">
                    🔒 Processamento integrado aos serviços da FCG.
                </small>
            </aside>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "orderId")]
    private string? OrderIdQuery { get; set; }

    private bool _processando;
    private bool _retornoRecebido;
    private bool _consultandoPedido;

    private string? _erro;
    private string? _orderId;

    private string _statusPedido = "Pending";

    private string _mensagemResultado =
        "O pedido foi criado e aguarda processamento.";

    private readonly List<CompraStatusViewModel> _compras = [];

    private CancellationTokenSource? _monitoramentoCts;
    private string? _ultimoPedidoConsultado;
    private bool _disposed;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(OrderIdQuery))
            return;

        if (string.Equals(
                _ultimoPedidoConsultado,
                OrderIdQuery,
                StringComparison.Ordinal))
            return;

        _ultimoPedidoConsultado = OrderIdQuery;

        _monitoramentoCts?.Cancel();
        _monitoramentoCts?.Dispose();

        _monitoramentoCts = new CancellationTokenSource();

        _retornoRecebido = true;
        _orderId = OrderIdQuery;

        await MonitorarPedidoAsync(
            OrderIdQuery,
            _monitoramentoCts.Token);
    }

    private async Task MonitorarPedidoAsync(
        string orderId,
        CancellationToken cancellationToken)
    {
        _consultandoPedido = true;
        _erro = null;

        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                try
                {
                    await ConsultarPedidoAsync(
                        orderId,
                        cancellationToken);

                    if (_statusPedido == "Approved" ||
                        _statusPedido == "Rejected")
                    {
                        return;
                    }

                    _erro = null;
                }
                catch (OperationCanceledException)
                    when (cancellationToken.IsCancellationRequested)
                {
                    return;
                }
                catch (Exception ex)
                {
                    _erro = ex.Message;

                    _mensagemResultado =
                        "Não foi possível consultar o pedido neste momento. " +
                        "O status ainda não foi confirmado. " +
                        "A consulta será tentada novamente.";
                }

                await Task.Delay(
                    TimeSpan.FromSeconds(3),
                    cancellationToken);
            }
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
            // Monitoramento cancelado ao sair da página.
        }
        finally
        {
            _consultandoPedido = false;
        }
    }

    private async Task ConsultarPedidoAsync(
        string orderId,
        CancellationToken cancellationToken)
    {
        // A Catalog API é a fonte da verdade.
        var pedido = await CheckoutService.ObterPedidoAsync(
            orderId,
            cancellationToken);

        _orderId = pedido.OrderId;

        var jogo = CarrinhoService.Itens.FirstOrDefault(
            item => string.Equals(
                item.Id,
                pedido.GameId,
                StringComparison.Ordinal));

        _compras.Clear();

        if (string.Equals(
                pedido.Status,
                "Approved",
                StringComparison.OrdinalIgnoreCase))
        {
            _statusPedido = "Approved";

            _mensagemResultado =
                "A Catalog API confirmou a aprovação do pedido. " +
                "O jogo está disponível na sua biblioteca.";

            _compras.Add(new CompraStatusViewModel
            {
                OrderId = pedido.OrderId,
                Titulo = jogo?.Titulo ?? "Jogo adquirido",
                Preco = pedido.Preco,
                Genero = jogo?.Genero ?? 11,
                Status = "Approved"
            });

            // Limpar somente depois da confirmação do backend.
            CarrinhoService.Limpar();
        }
        else if (string.Equals(
                     pedido.Status,
                     "Rejected",
                     StringComparison.OrdinalIgnoreCase))
        {
            _statusPedido = "Rejected";

            _mensagemResultado =
                "A Catalog API confirmou que o pedido foi recusado. " +
                "Seu carrinho foi preservado.";

            _compras.Add(new CompraStatusViewModel
            {
                OrderId = pedido.OrderId,
                Titulo = jogo?.Titulo ?? "Jogo do pedido",
                Preco = pedido.Preco,
                Genero = jogo?.Genero ?? 11,
                Status = "Rejected"
            });
        }
        else
        {
            _statusPedido = "Pending";

            _mensagemResultado =
                "O pedido continua em processamento. " +
                "Estamos aguardando a confirmação dos microsserviços.";

            _compras.Add(new CompraStatusViewModel
            {
                OrderId = pedido.OrderId,
                Titulo = jogo?.Titulo ?? "Jogo do pedido",
                Preco = pedido.Preco,
                Genero = jogo?.Genero ?? 11,
                Status = "Pending"
            });
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmarCompra()
    {
        if (_processando || CarrinhoService.Quantidade == 0)
            return;

        _processando = true;
        _erro = null;

        try
        {
            if (CarrinhoService.Quantidade != 1)
            {
                throw new InvalidOperationException(
                    "O checkout atual processa um jogo por vez. " +
                    "Deixe apenas um jogo no carrinho.");
            }

            var jogo = CarrinhoService.Itens.Single();

            // Solicita a aquisição ao backend.
            var resultado = await CheckoutService.AdquirirAsync(
                jogo.Id);

            if (string.IsNullOrWhiteSpace(resultado.OrderId))
            {
                throw new InvalidOperationException(
                    "A API não retornou o identificador do pedido.");
            }

            // Preserva o identificador na URL.
            // A próxima etapa consulta o status real na Catalog API.
            Navigation.NavigateTo(
                $"/checkout?orderId={Uri.EscapeDataString(resultado.OrderId)}");
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _processando = false;
        }
    }

    private void VoltarParaCarrinho() =>
        Navigation.NavigateTo("/carrinho");

    private void VoltarParaCatalogo() =>
        Navigation.NavigateTo("/catalogo");

    private void VoltarParaBiblioteca() =>
        Navigation.NavigateTo("/biblioteca");

    private static string ObterNomeGenero(int genero) => genero switch
    {
        0 => "Ação",
        1 => "Aventura",
        2 => "RPG",
        3 => "Estratégia",
        4 => "Esporte",
        5 => "Corrida",
        6 => "Simulação",
        7 => "Puzzle",
        8 => "FPS",
        9 => "MOBA",
        10 => "Educacional",
        11 => "Outro",
        _ => "Jogo"
    };

    public void Dispose()
    {
        _disposed = true;

        _monitoramentoCts?.Cancel();
        _monitoramentoCts?.Dispose();
        _monitoramentoCts = null;
    }

    private sealed class CompraStatusViewModel
    {
        public string OrderId { get; init; } = string.Empty;
        public string Titulo { get; init; } = string.Empty;
        public decimal Preco { get; init; }
        public int Genero { get; init; }
        public string Status { get; set; } = "Pending";
    }
}
